#!/usr/bin/env python3
"""ANT material tools for independent clib applications."""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time
sys.dont_write_bytecode = True
BASE=Path(__file__).resolve().parent.parent
sys.path.insert(0,str(BASE/'tools'))
from materials import seal
from prepare_catalogue import prepare as prepare_catalogue

def run(cmd, log=None):
    env={**os.environ,'OMP_NUM_THREADS':'32','OMP_WAIT_POLICY':'PASSIVE'}
    if log:
        with log.open('w') as f:subprocess.run(list(map(str,cmd)),stdout=f,stderr=subprocess.STDOUT,env=env,check=True)
    else:subprocess.run(list(map(str,cmd)),env=env,check=True)

def main():
    ap=argparse.ArgumentParser(description=__doc__);sub=ap.add_subparsers(dest='command',required=True)
    p=sub.add_parser('prepare',help='Generate a new application context from JSON');p.add_argument('--config',type=Path,required=True);p.add_argument('--out',type=Path,required=True)
    for cmd in ['encode','encrypt']:
        p=sub.add_parser(cmd);p.add_argument('--private',type=Path,required=True);p.add_argument('--values',type=Path,required=True);p.add_argument('--q-limbs',type=int,required=True);p.add_argument('--out',type=Path,required=True)
    p=sub.add_parser('decrypt');p.add_argument('--private',type=Path,required=True);p.add_argument('--input',type=Path,required=True);p.add_argument('--out',type=Path,required=True)
    p=sub.add_parser('batch',help='Rows: encode|encrypt Q_LIMBS "VALUES" "OUTPUT"');p.add_argument('--private',type=Path,required=True);p.add_argument('--requests',type=Path,required=True)
    for cmd in ['application-context','application-encode','application-verify']:
        p=sub.add_parser(cmd,help='SDK Makefile pipeline step (reads generated encode.inc)')
        p.add_argument('--work',type=Path,required=True)
        if cmd=='application-verify':p.add_argument('--output',type=Path,required=True)
    a=ap.parse_args();native=BASE/'tools/ant-native'
    if a.command.startswith('application-'):
        from application import main as application_main
        application_main(a.command,BASE,a.work,getattr(a,'output',None))
        return
    if a.command == 'prepare':
        config=json.loads(a.config.read_text())
        if not isinstance(config,dict) or set(config)-{'N','q_limbs','rotations'}:raise ValueError('config fields: N, q_limbs, rotations')
        n=config.get('N',1024);q=config.get('q_limbs',62);r=config.get('rotations',[])
        if type(n)!=int or n not in (1024,8192,65536):raise ValueError('N must be 1024, 8192 or 65536')
        if type(q)!=int or q<32 or q>62 or q%2:raise ValueError('q_limbs must be even in [32,62]')
        if not isinstance(r,list) or any(type(x)!=int or not -(2**31)<=x<2**31 for x in r):raise ValueError('rotations must be a list of int32 steps')
        r=sorted({x%(n//2) for x in r}-{0})
        if len(r)>=512:raise ValueError('too many rotations; total including bootstrap must be <512')
        out=a.out.resolve();out.mkdir(mode=0o700,parents=True,exist_ok=False);t=time.monotonic()
        rotations=out/'rotations.txt';rotations.write_text(' '.join(map(str,r))+'\n')
        material=out/'evaluation';private=out/'private';private.mkdir(mode=0o700)
        run([native,'prepare-context',material,n,q,rotations],out/'ant_prepare.log')
        for name in ['decryptor.txt','encoder.txt','encryptor.txt']:
            shutil.move(material/name,private/name);(private/name).chmod(0o600)
        for name in ['u0_pre_fft2.txt','u0hat_pre_fft2.txt']:(material/'plain'/name).unlink(missing_ok=True)
        print('ANT context ready; preparing its scalar catalogue...',flush=True)
        count=prepare_catalogue(native,BASE/'tools/prepare-scalars',material,private,out/'preparation')
        pid,kid=seal(material);shutil.copy2(material/'identity.txt',private/'identity.txt')
        lines=(material/'param.txt').read_text().splitlines()
        p=int(next(s.split()[1] for s in lines if s.startswith('[K:]')))
        boot=(material/'bootstrap.txt').read_text().splitlines()
        depth=int(boot[3].split()[0])+int(boot[1].split()[0])+int(boot[2].split()[0])
        summary={'N':n,'slots':n//2,'q_limbs':q,'p_limbs':p,'DS':1,'DNUM':1,'H':80,'rotations':r,'bootstrap_max_q_limbs':q-2*depth,'profile_id':pid,'keyset_id':kid,'scalar_records':count,'prepare_seconds':time.monotonic()-t}
        (out/'case.json').write_text(json.dumps(summary,indent=2)+'\n')
        print(f'Prepared {out}\nEvaluation: {material}\nANT private material: {private}\nSummary: {out}/case.json')
    elif a.command=='batch':run([native,'batch',a.private.resolve(),a.requests.resolve()])
    elif a.command=='decrypt':
        a.out.resolve().parent.mkdir(parents=True,exist_ok=True)
        run([native,'decrypt',a.private.resolve(),a.input.resolve(),a.out.resolve()])
    else:
        a.out.resolve().parent.mkdir(parents=True,exist_ok=True)
        run([native,a.command,a.private.resolve(),a.values.resolve(),a.q_limbs,a.out.resolve()])

if __name__=='__main__':
    try:main()
    except (ValueError,OSError,subprocess.CalledProcessError) as e:
        print(f'clib-ant-tool: {e}',file=sys.stderr);sys.exit(1)
