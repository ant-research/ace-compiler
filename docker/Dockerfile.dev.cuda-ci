# ============================================================
# ACE-Compiler Dev Image (CUDA) — CI BUILD-ONLY variant
#
# Same content as Dockerfile.dev.cuda (CUDA toolkit + system deps + Python +
# PyTorch), but built FROM ubuntu:24.04 instead of FROM nvidia/cuda:*.
#
# Why: CI runners that lack a GPU/driver fail to start an nvidia/cuda-based
# image because the container runtime injects an nvidia-container-runtime-hook
# that tries to bind-mount a GPU device (error: "nvidia-container-cli:
# initialization error: driver error: failed to process request"). The hook is
# triggered by the image's NVIDIA identity, inherited from nvidia/cuda:*.
#
# This image has NO such identity (CUDA toolkit installed via apt, not via the
# nvidia/cuda base layer), so no GPU device injection happens and the container
# starts on a plain CPU runner. Building ACE only needs the CUDA toolkit
# (compile-time dependency); it does not need a GPU device. See
# docs/dev/develop.md — "CUDA toolkit is a compile-time only dependency".
#
# Use this image for CI build jobs that must compile the GPU backends
# (Phantom/ACE) on CPU-only runners. Do NOT use it to run GPU workloads —
# there is no driver/device.
#
# Resulting package parity: an ACE wheel built here is byte-for-bit equivalent
# in capabilities to one built in Dockerfile.dev.cuda; only the build
# environment differs.
#
# Usage (internal):
#   docker build --build-arg CUDA_VERSION=12.8.0 \
#                --build-arg CUDA_APT_VER=12-8 \
#                --build-arg UBUNTU=ubuntu24.04 \
#                --build-arg PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
#                --build-arg TORCH_VERSION=2.11.0 \
#                --build-arg TORCHVISION_VERSION=0.26.0 \
#                --build-arg TORCHAUDIO_VERSION=2.11.0 \
#                --build-arg CU_VERSION=cu128 \
#                --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128 \
#                -f docker/Dockerfile.dev.cuda-ci \
#                -t ace/dev-cuda:12.8.0-aci-ubuntu24.04 .
# ============================================================

ARG UBUNTU=ubuntu:24.04
FROM ${UBUNTU}

# Environment defaults
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
ENV CMAKE_BUILD_TYPE=Release
ARG ARTIFACT_URL=https://artifacts.antgroup-inc.cn/artifact/repositories/simple-dev
ENV ARTIFACT_URL=${ARTIFACT_URL}

# ----------------------------------------------------------------------------
# System dependencies (mirrors Dockerfile.dev.cuda)
# ----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl wget vim gdb time doxygen graphviz autoconf \
    build-essential gcc g++ clang-15 clang-format-15 nlohmann-json3-dev \
    cmake make ninja-build \
    python3 python3-dev python3-pip python3-venv pylint \
    libprotobuf-dev protobuf-compiler libssl-dev libtool \
    libgmp3-dev libomp5 libomp-dev libntl-dev pybind11-dev && \
    update-alternatives --install /usr/bin/clang-format clang-format /usr/bin/clang-format-15 100 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------------------
# CUDA toolkit — installed via NVIDIA's apt repo, NOT via nvidia/cuda base layer.
# cuda-toolkit-* contains nvcc + libs + headers, no driver. This keeps the image
# free of the NVIDIA container identity that triggers device injection on CI.
# ----------------------------------------------------------------------------
ARG UBUNTU_RELEASE=ubuntu2404
ARG CUDA_APT_VER=12-8
ARG CUDA_VERSION=12.8.0
RUN apt-get update && apt-get install -y --no-install-recommends gnupg ca-certificates && \
    wget -qO /tmp/cuda-keyring.deb \
        https://developer.download.nvidia.com/compute/cuda/repos/${UBUNTU_RELEASE}/x86_64/cuda-keyring_1.1-1_all.deb && \
    dpkg -i /tmp/cuda-keyring.deb && \
    rm /tmp/cuda-keyring.deb && \
    apt-get update && \
    apt-get install -y --no-install-recommends cuda-toolkit-${CUDA_APT_VER} && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# nvcc and libs land under /usr/local/cuda-<ver>; the cuda-toolkit metapackage
# creates the /usr/local/cuda symlink. Expose them on PATH / LD_LIBRARY_PATH so
# find_package(CUDA) and CMake's nvcc discovery work exactly as under the
# nvidia/cuda base image.
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH:-}

# Configure git safe.directory for Docker builds
RUN git config --global --add safe.directory '*'

# ----------------------------------------------------------------------------
# Python environment (mirrors Dockerfile.dev.cuda)
# ----------------------------------------------------------------------------
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN python3 -m venv /opt/ace-env && \
    /opt/ace-env/bin/pip config set global.index-url ${PIP_INDEX_URL} && \
    /opt/ace-env/bin/pip install --no-cache-dir --upgrade pip setuptools wheel

# Set PATH to use venv
ENV PATH=/opt/ace-env/bin:$PATH

# Install common Python dependencies
COPY docker/requirements-base.txt /tmp/requirements-base.txt
RUN pip install --no-cache-dir -r /tmp/requirements-base.txt

# Install PyTorch CUDA
ARG TORCH_VERSION=2.11.0
ARG TORCHVISION_VERSION=0.26.0
ARG TORCHAUDIO_VERSION=2.11.0
# CU_VERSION must match an available PyTorch wheel: cu128, cu130
# CUDA 12.8 hosts: use cu128
# CUDA 13.0 hosts: use cu130
# CUDA 13.1 hosts: use cu130 (no cu131 wheel yet; cu130 is forward-compatible)
ARG CU_VERSION=cu128
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
RUN pip install --no-cache-dir \
        --extra-index-url ${TORCH_INDEX_URL} \
        torch==${TORCH_VERSION}+${CU_VERSION} \
        torchvision==${TORCHVISION_VERSION}+${CU_VERSION} \
        torchaudio==${TORCHAUDIO_VERSION}+${CU_VERSION} \
        torchsummary

WORKDIR /app
CMD ["/bin/bash"]
